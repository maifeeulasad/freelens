{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["esnext", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@freelensapp/utilities": ["../../packages/utility-features/utilities/browser.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "comment:exclude": "The full-renderer boot is a phase-1 experiment (see web/README.md) that aliases untyped Node-polyfill packages; it is built separately and excluded from the shipped app's type-check.",
  "exclude": ["src/boot.tsx", "src/node-globals.ts", "src/stubs/**"]
}
